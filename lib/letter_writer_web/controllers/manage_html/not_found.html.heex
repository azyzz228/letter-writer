<Layouts.app flash={@flash}>
  <section class="locked-shell unavailable-shell" id="management-link-unavailable">
    <div class="faded-seal" aria-hidden="true">S</div>
    <p class="eyebrow">Private link unavailable</p>
    <h1>This management link is no longer valid.</h1>
    <p class="locked-lede">The letter may have completed its retention period or the link may be incomplete.</p>
    <.link navigate={~p"/write"} class="button button-primary">Write a new letter</.link>
  </section>
</Layouts.app>
