<Layouts.app flash={@flash}>
  <section class="manage-shell" id="manage-letter">
    <div class="manage-heading">
      <div>
        <p class="eyebrow">Private writer link</p>
        <h1>Watch over your letter.</h1>
      </div>
      <span class={["status-pill", "status-#{@status.status}"]}>
        {status_label(@status.status)}
      </span>
    </div>

    <div class="stats-grid">
      <article>
        <span>Openings used</span>
        <strong>{@status.opens_used}</strong>
        <small>
          <%= if @status.max_opens do %>
            of {@status.max_opens} allowed
          <% else %>
            unlimited
          <% end %>
        </small>
      </article>
      <article>
        <span>First opened</span>
        <strong class="stat-date">{format_datetime(@status.first_opened_at)}</strong>
      </article>
      <article>
        <span>Last opened</span>
        <strong class="stat-date">{format_datetime(@status.last_opened_at)}</strong>
      </article>
      <article>
        <span>Available until</span>
        <strong class="stat-date">
          <%= if @status.expires_at do %>
            {format_datetime(@status.expires_at)}
          <% else %>
            No expiry
          <% end %>
        </strong>
      </article>
    </div>

    <div class="manage-note">
      <.icon name="hero-lock-closed-mini" class="size-5" />
      <div>
        <strong>The words remain private.</strong>
        <p>
          This page can show delivery status and recall the letter, but it can never reveal or edit its contents.
        </p>
      </div>
    </div>

    <div :if={@status.status != :revoked} class="danger-zone">
      <div>
        <h2>Recall this letter</h2>
        <p>This immediately ends active reading sessions and cannot be undone.</p>
      </div>
      <.form
        for={to_form(%{}, as: :revoke)}
        id="revoke-letter-form"
        action={~p"/manage/#{@status.id}/#{@management_token}/revoke"}
        method="post"
      >
        <button type="submit" class="danger-button" data-confirm="Recall this letter permanently?">
          Recall permanently
        </button>
      </.form>
    </div>
  </section>
</Layouts.app>
